# ================================
# GoLearn — Environment Variables
# ================================
# Copy this file to .env and fill in all values

# Backend
PORT=8080
DB_URL=postgres://golearn:golearn_secret@localhost:5432/golearn?sslmode=disable

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars

# Auth cookie (production-ready)
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Google OAuth
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URLs
# FRONTEND_URL supports a comma-separated allowlist in production if needed.
FRONTEND_URL=http://localhost:3006
NEXT_PUBLIC_API_URL=http://localhost:8081
